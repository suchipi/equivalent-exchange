{
  "name": "equivalent-exchange",
  "version": "7.0.0",
  "description": "Transmute one JavaScript string into another by way of mutating its AST. Powered by [babel](https://babeljs.io/) and [recast](https://www.npmjs.com/package/recast).",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "test": "vitest",
    "build": "tsc && cp dist/*.d.ts api/ && rm api/build-docs.d.ts && prettier --write api/*.d.ts && node ./dist/build-docs.js"
  },
  "keywords": [
    "ast",
    "transform",
    "codemod",
    "babel",
    "recast",
    "transmute",
    "transmutation"
  ],
  "author": "Lily Skye <me@suchipi.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/suchipi/equivalent-exchange.git"
  },
  "devDependencies": {
    "@suchipi/dtsmd": "^1.4.0",
    "@types/debug": "^4.1.13",
    "@types/node": "^24.3.0",
    "clefairy": "^2.1.0",
    "glomp": "^3.1.1",
    "nice-path": "^3.2.2",
    "prettier": "^3.9.6",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "@babel/core": "^7.29.7",
    "@babel/generator": "^7.29.8",
    "@babel/parser": "^7.29.8",
    "@babel/template": "^7.29.7",
    "@babel/traverse": "^7.29.8",
    "@babel/types": "^7.29.8",
    "@types/babel__core": "^7.20.5",
    "debug": "^4.4.3",
    "parallel-park": "^0.3.1",
    "recast": "^0.23.19",
    "tinyglobby": "^0.2.17"
  },
  "prettier": {},
  "allowScripts": {
    "esbuild@0.28.1": true,
    "fsevents@2.3.3": true
  }
}
